---
import AnchorHeading from '@astrojs/starlight/components/AnchorHeading.astro';

const base = import.meta.env.BASE_URL;

const steps = [
  {
    id: 'sunucuyu-hazrla',
    step: '1. Adım · Day 0',
    title: 'Sunucuyu hazırla',
    description: 'İlk SSH bağlantısını kur, kullanıcı ve güvenlik duvarı (UFW) ayarlarını tamamla, Docker Engine yükle.',
    href: 'getting-started/roadmap/#day-0',
  },
  {
    id: 'uygulamay-yaynla',
    step: '2. Adım · Day 1',
    title: 'Uygulamayı yayınla',
    description: 'Reverse proxy ve TLS sertifikasını kur, veritabanını iç ağa izole et ve konteynerleri ayağa kaldır.',
    href: 'getting-started/roadmap/#day-1',
  },
  {
    id: 'canl-sistemi-islet',
    step: '3. Adım · Day 2',
    title: 'Canlı sistemi işlet',
    description: 'İzleme ve log rotasyonunu devreye al, otomatik yedeklemeyi kur ve geri yükleme (restore) testi yap.',
    href: 'getting-started/roadmap/#day-2',
  },
] as const;

const categories = [
  {
    title: 'Kurulum & Mimari',
    description: 'Sıfır sunucudan çalışan konteyner altyapısına geçiş rehberleri.',
    mainLink: { label: 'Tüm kurulum rehberleri', path: 'how-to/' },
    items: [
      { label: 'İlk bağlantı ve temel sistem', path: 'how-to/base-os/' },
      { label: 'Docker & Compose kurulumu', path: 'how-to/docker/' },
      { label: 'Reverse Proxy & TLS (HTTPS)', path: 'how-to/reverse-proxy/' },
      { label: 'Port stratejisi ve ağ mimarisi', path: 'architecture/port-strategy/' },
      { label: 'Monitoring & merkezi loglama', path: 'how-to/monitoring-stack/' },
    ],
  },
  {
    title: 'Güvenlik',
    description: 'Sunucu, ağ ve konteyner katmanları için zorunlu güvenlik standartları.',
    mainLink: { label: 'Güvenlik genel bakış', path: 'security/' },
    items: [
      { label: 'SSH sertleştirme (Hardening)', path: 'security/ssh/' },
      { label: 'UFW güvenlik duvarı kuralları', path: 'security/firewall/' },
      { label: 'Docker Gateway (UFW bypass önleme)', path: 'security/docker-gateway/' },
      { label: 'Konteyner güvenliği (Non-root)', path: 'security/docker/' },
      { label: 'Şifre ve secret yönetimi', path: 'security/secrets/' },
    ],
  },
  {
    title: 'Şablon & Reçete',
    description: 'Kopyala-yapıştır prod konfigürasyonları ve canlıya geçiş kontrol listeleri.',
    mainLink: { label: 'Tüm reçeteler', path: 'recipes/' },
    items: [
      { label: 'Docker Compose temel şablonu', path: 'file-templates/docker-compose/' },
      { label: 'PostgreSQL & Redis prod ayarları', path: 'recipes/postgres/' },
      { label: '.NET Core & React + Nginx', path: 'recipes/dotnet/' },
      { label: 'Nginx prod konfigürasyonu', path: 'file-templates/nginx/' },
      { label: 'Canlıya geçiş (Go / No-Go) listesi', path: 'checklists/prod-ready/' },
    ],
  },
  {
    title: 'Olay & Arıza (Runbooks)',
    description: 'Canlı sistemde kesinti, kaynak dolması veya erişim sorunlarında hızlı müdahale.',
    mainLink: { label: 'Tüm runbooklar', path: 'runbooks/' },
    items: [
      { label: 'Servis kesintisi müdahalesi', path: 'runbooks/service-down/' },
      { label: 'Veritabanı erişim sorunu', path: 'runbooks/db-down/' },
      { label: 'Disk veya Inode dolması', path: 'runbooks/disk-full/' },
      { label: 'OOM Kill & CPU yükselmesi', path: 'runbooks/oom-kill/' },
      { label: 'Hızlı arıza teşhis komutları', path: 'troubleshooting/cheat-sheet/' },
    ],
  },
  {
    title: 'Araçlar, Scriptler & AI',
    description: 'Hazır otomasyon scriptleri, CLI komut referansı ve AI geliştirme kuralları.',
    mainLink: { label: 'Komut referansı', path: 'reference/' },
    items: [
      { label: 'Sunucu ilk kurulum (Bootstrap) scripti', path: 'scripts/library/bootstrap/' },
      { label: 'Veritabanı yedekleme & restore scripti', path: 'scripts/library/backup/' },
      { label: 'Linux, Ağ ve Docker komut referansı', path: 'reference/commands/system/' },
      { label: 'AI ile geliştirme (Altyapı bağlamı)', path: 'ai-dev/infra-context/' },
      { label: 'AI denetim kapıları (Audit Gates)', path: 'ai-dev/ai-audit-gates/' },
    ],
  },
] as const;
---

<div class="home-layout not-content">
  <span id="sunucunu-kuruygulaman-yayna-al" aria-hidden="true"></span>

  <section aria-labelledby="kurulum-admlar">
    <div class="section-header">
      <AnchorHeading level={2} id="kurulum-admlar">Kurulum adımları</AnchorHeading>
      <a class="section-more" href={`${base}getting-started/roadmap/`}>Yol haritasının tamamı →</a>
    </div>

    <ol class="steps-grid" role="list">
      {steps.map(({ id, step, title, description, href }) => (
        <li {id}>
          <a class="step-card" href={`${base}${href}`}>
            <span class="step-kicker">{step}</span>
            <strong class="step-title">{title}</strong>
            <span class="step-desc">{description}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="belirli-bir-is-icin-geldin-mi">
    <div class="section-header">
      <AnchorHeading level={2} id="belirli-bir-is-icin-geldin-mi">Kategoriler ve hızlı erişim</AnchorHeading>
    </div>

    <div class="category-grid">
      {categories.map(({ title, description, mainLink, items }) => (
        <div class="category-card">
          <div class="category-top">
            <h3>{title}</h3>
            <p>{description}</p>
          </div>
          <ul class="category-links" role="list">
            {items.map((item) => (
              <li>
                <a href={`${base}${item.path}`}>{item.label}</a>
              </li>
            ))}
          </ul>
          <a class="category-footer" href={`${base}${mainLink.path}`}>
            {mainLink.label} →
          </a>
        </div>
      ))}
    </div>
  </section>
</div>

<style>
  /* Clean, Spacious Hero (Cloudflare / Stripe Docs style) */
  :global([data-has-hero] .hero) {
    display: block;
    padding-block: clamp(1.5rem, 3.5vw, 2.75rem);
    border-bottom: 1px solid var(--handbook-border);
  }

  :global([data-has-hero] .hero .stack) {
    align-items: flex-start;
    gap: 1.25rem;
    max-width: 48rem;
    margin: 0;
    text-align: start;
  }

  :global([data-has-hero] .hero .copy) {
    align-items: flex-start;
    gap: 0.75rem;
  }

  :global([data-has-hero] .hero h1) {
    color: var(--sl-color-white);
    font-size: clamp(1.85rem, 3.8vw, 2.75rem);
    font-weight: 740;
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  :global([data-has-hero] .hero .tagline) {
    color: var(--sl-color-gray-2);
    font-size: clamp(1rem, 1.35vw, 1.125rem);
    line-height: 1.65;
  }

  :global([data-has-hero] .hero .actions) {
    justify-content: flex-start;
    gap: 0.75rem;
  }

  :global([data-has-hero] .hero .sl-link-button) {
    min-height: 2.5rem;
    border-radius: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 600;
  }

  :global([data-has-hero] .hero .primary) {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent);
    color: #fff;
  }

  :global([data-has-hero] .hero .primary:hover) {
    border-color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-high);
  }

  :global([data-has-hero] .hero .secondary) {
    border: 1px solid var(--handbook-border);
    background: var(--handbook-surface);
    color: var(--sl-color-white);
  }

  :global([data-has-hero] .hero .secondary:hover) {
    border-color: var(--sl-color-gray-4);
    background: var(--handbook-subtle);
  }

  /* Main Home Layout */
  .home-layout {
    display: grid;
    gap: 3rem;
    margin-top: 2rem;
    padding-bottom: 2rem;
  }

  .home-layout > span {
    position: absolute;
  }

  .section-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }

  .section-header :global(h2) {
    color: var(--sl-color-white);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .section-header :global(.sl-anchor-link) {
    display: none;
  }

  .section-more {
    color: var(--sl-color-accent-high);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
  }

  .section-more:hover {
    text-decoration: underline;
  }

  /* 3 Steps Row */
  .steps-grid {
    display: grid;
    gap: 1rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .step-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    height: 100%;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--handbook-border);
    border-radius: 0.65rem;
    background: var(--handbook-surface);
    color: var(--sl-color-white);
    text-decoration: none;
    transition: border-color 140ms ease;
  }

  .step-card:hover {
    border-color: var(--sl-color-accent);
  }

  .step-kicker {
    color: var(--sl-color-accent-high);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .step-title {
    font-size: 1.1rem;
    font-weight: 680;
    letter-spacing: -0.015em;
  }

  .step-desc {
    color: var(--sl-color-gray-2);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  /* 5 Categories Directory Grid */
  .category-grid {
    display: grid;
    gap: 1.15rem;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.35rem;
    border: 1px solid var(--handbook-border);
    border-radius: 0.65rem;
    background: var(--handbook-surface);
  }

  .category-top h3 {
    margin: 0 0 0.35rem;
    color: var(--sl-color-white);
    font-size: 1.08rem;
    font-weight: 680;
    letter-spacing: -0.015em;
  }

  .category-top p {
    margin: 0 0 1rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .category-links {
    display: grid;
    gap: 0.45rem;
    padding: 0;
    margin: 0 0 1.15rem;
    list-style: none;
    border-top: 1px solid var(--handbook-border);
    padding-top: 0.9rem;
  }

  .category-links a {
    display: block;
    color: var(--sl-color-gray-1);
    font-size: 0.875rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .category-links a:hover {
    color: var(--sl-color-accent-high);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .category-footer {
    display: inline-flex;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--handbook-border);
    color: var(--sl-color-accent-high);
    font-size: 0.84rem;
    font-weight: 600;
    text-decoration: none;
  }

  .category-footer:hover {
    text-decoration: underline;
  }

  @media (min-width: 48rem) {
    .steps-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .category-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
