---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SectionLinks from './SectionLinks.astro';

const isHome = Astro.url.pathname === import.meta.env.BASE_URL;
---

<div class:list={['handbook-header', { 'home-header': isHome }]}>
  <div class="brand"><SiteTitle /></div>
  <div class="sections"><SectionLinks /></div>
  <div class="controls">
    <Search />
    <div class="theme"><ThemeSelect /></div>
  </div>
</div>

<style>
  .handbook-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.5rem;
    height: 100%;
    max-width: 88rem;
    margin-inline: auto;
  }
  .home-header {
    max-width: var(--handbook-home-width);
  }
  .brand {
    min-width: 0;
  }
  .brand :global(.site-title) {
    gap: 0.6rem;
    color: var(--sl-color-white);
    font-size: clamp(1.05rem, 2.4vw, 1.2rem);
    font-weight: 740;
    letter-spacing: -0.035em;
  }
  .brand :global(.site-title img) {
    flex: none;
    width: 2rem;
    height: 2rem;
  }
  .controls {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    grid-area: 1 / 2;
  }
  .controls :global(button[data-open-modal]) {
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--handbook-border);
    border-radius: 0.6rem;
    background: var(--handbook-subtle);
  }
  .controls :global(button[data-open-modal]:hover) {
    border-color: var(--sl-color-gray-4);
  }
  .sections,
  .theme {
    display: none;
  }
  .home-header .theme {
    display: flex;
  }
  .theme :global(select) {
    min-height: 2.5rem;
    --sl-select-width: 8em;
  }
  @media (max-width: 49.999rem) {
    .home-header {
      grid-template-rows: auto auto;
    }
    .home-header .sections {
      display: block;
      grid-area: 2 / 1 / 3 / -1;
      border-top: 1px solid var(--handbook-border);
      padding-block: 0.25rem;
    }
    .home-header .sections :global(nav) {
      justify-content: center;
    }
    .home-header .sections :global(a) {
      padding-inline: 0.5rem;
      line-height: 1.4;
    }
    .theme :global(label) {
      --sl-inline-padding: 0rem;
    }
    .theme :global(select) {
      --sl-select-width: 2.75rem;
      padding: 0;
      color: transparent;
    }
  }
  @media (min-width: 50rem) {
    .handbook-header {
      grid-template-columns: 1fr auto 1fr;
      column-gap: 1rem;
    }
    .sections,
    .theme {
      display: block;
    }
    .controls {
      grid-area: 1 / 3;
      gap: 0.75rem;
    }
    .controls :global(button[data-open-modal]) {
      justify-content: flex-start;
      width: clamp(9.6rem, 17vw, 15rem);
      gap: 0.6rem;
    }
    .theme {
      border-inline-start: 1px solid var(--handbook-border);
      padding-inline-start: 0.65rem;
    }
  }
  @media (min-width: 50rem) and (max-width: 61.999rem) {
    .handbook-header {
      grid-template-columns: auto 1fr auto;
    }
    .controls :global(button[data-open-modal]) {
      justify-content: center;
      width: 2.5rem;
    }
    .controls :global(button[data-open-modal] > :is(span, kbd)) {
      display: none;
    }
  }
</style>
