---
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import SectionLinks from './SectionLinks.astro';
---

<div class="handbook-header">
  <div class="brand"><SiteTitle /></div>
  <div class="sections"><SectionLinks /></div>
  <div class="controls">
    <Search />
    <div class="theme"><ThemeSelect /></div>
  </div>
</div>

<style>
  .handbook-header {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 2vw, 2rem);
    min-width: 0;
    height: 100%;
  }
  .brand {
    min-width: 0;
  }
  .controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-inline-start: auto;
  }
  .sections,
  .theme {
    display: none;
  }
  .theme :global(select) {
    --sl-select-width: 8em;
  }
  @media (min-width: 50rem) {
    .sections,
    .theme {
      display: block;
    }
  }
</style>
