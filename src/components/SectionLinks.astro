---
import { sections } from '../navigation.mjs';

const { handbookSection } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL;
---

<nav aria-label="Ana bölümler">
  {sections.map(({ label, landing }) => (
    <a href={`${base}${landing}/`} aria-current={handbookSection === label ? 'true' : undefined}>
      {label}
    </a>
  ))}
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  a {
    padding: 0.4rem 0.65rem;
    border-radius: 0.55rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 650;
    text-decoration: none;
    white-space: nowrap;
  }
  a:hover {
    background: var(--handbook-subtle);
    color: var(--sl-color-white);
  }
  a[aria-current] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
  }
  @media (min-width: 50rem) {
    nav {
      justify-content: center;
    }
  }
</style>
