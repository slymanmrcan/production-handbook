---
import { sections } from '../navigation.mjs';

const { handbookSection } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL;
---

<nav aria-label="Ana bölümler">
  {sections.map(({ label, landing }) => (
    <a href={`${base}${landing}/`} aria-current={handbookSection === label ? 'true' : undefined}>
      {label}
    </a>
  ))}
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }
  a {
    padding: 0.45rem 0.65rem;
    border-radius: 0.35rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
  }
  a:hover,
  a[aria-current] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
</style>
