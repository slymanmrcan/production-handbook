---
import { sections } from '../navigation.mjs';

const { handbookSection } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL;
---

<nav aria-label="Ana bölümler">
  {sections.map(({ label, landing }) => (
    <a
      href={`${base}${landing}/`}
      aria-current={handbookSection === label ? 'true' : undefined}
    >
      {label}
    </a>
  ))}
</nav>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
  }
  a {
    padding: 0.42rem 0.75rem;
    border-radius: 0.45rem;
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    font-weight: 550;
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms ease, background-color 120ms ease;
  }
  a:hover {
    background: var(--handbook-subtle);
    color: var(--sl-color-white);
  }
  a[aria-current] {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 650;
  }
  @media (min-width: 50rem) {
    nav {
      justify-content: center;
    }
  }
</style>
