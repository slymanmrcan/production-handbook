---
import StarlightSidebar from '@astrojs/starlight/components/Sidebar.astro';
import SectionLinks from './SectionLinks.astro';
---

<div class="mobile-sections"><SectionLinks /></div>
<StarlightSidebar />

<style>
  .mobile-sections {
    padding-block-end: 0.9rem;
    border-bottom: 1px solid var(--handbook-border);
  }
  @media (min-width: 50rem) {
    .mobile-sections {
      display: none;
    }
  }
</style>
